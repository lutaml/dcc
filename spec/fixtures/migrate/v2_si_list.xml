<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hand-built DCC v2.3.0 document holding the constructs the object model
  cannot round-trip: a D-SI v1 shaped si:list whose reals sit directly inside
  the list carrying the deprecated uncertainty forms, and a previousReport.

  Exercised at the transform level only. Dcc::Si::Base::SiList has no mapping
  for a v1 list's direct si:real children, and Dcc::Base::HashType types
  `referral` as :string where the XSD says textType, so neither survives
  Dcc.parse. Asserting this document through Dcc.migrate would fail for
  reasons that have nothing to do with migration.
-->
<dcc:digitalCalibrationCertificate
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://ptb.de/dcc https://ptb.de/dcc/v2.3.0/dcc.xsd"
    xmlns:dcc="https://ptb.de/dcc"
    xmlns:si="https://ptb.de/si"
    schemaVersion="2.3.0">

  <dcc:administrativeData>
    <dcc:dccSoftware>
      <dcc:software>
        <dcc:name><dcc:content>List Tool</dcc:content></dcc:name>
        <dcc:release>v1.0</dcc:release>
      </dcc:software>
    </dcc:dccSoftware>

    <dcc:coreData>
      <dcc:countryCodeISO3166_1>DE</dcc:countryCodeISO3166_1>
      <dcc:usedLangCodeISO639_1>en</dcc:usedLangCodeISO639_1>
      <dcc:mandatoryLangCodeISO639_1>en</dcc:mandatoryLangCodeISO639_1>
      <dcc:uniqueIdentifier>LIST-0001</dcc:uniqueIdentifier>
      <dcc:beginPerformanceDate>2024-01-01</dcc:beginPerformanceDate>
      <dcc:endPerformanceDate>2024-01-02</dcc:endPerformanceDate>
      <dcc:previousReport>
        <dcc:reference>
          <dcc:content lang="en">Previous calibration report</dcc:content>
        </dcc:reference>
        <dcc:referenceID>PREV-0001</dcc:referenceID>
        <dcc:procedure>SHA-256</dcc:procedure>
        <dcc:value>3a7bd3e2360a3d29eea436fcfb7e44c735d117c4</dcc:value>
      </dcc:previousReport>
    </dcc:coreData>

    <dcc:items>
      <dcc:item>
        <dcc:name><dcc:content>Calibration item</dcc:content></dcc:name>
        <dcc:description><dcc:content lang="en">Item under test.</dcc:content></dcc:description>
        <dcc:manufacturer>
          <dcc:name><dcc:content>Instrument Maker GmbH</dcc:content></dcc:name>
        </dcc:manufacturer>
        <dcc:identifications>
          <dcc:identification>
            <dcc:issuer>manufacturer</dcc:issuer>
            <dcc:value>SN-0002</dcc:value>
          </dcc:identification>
        </dcc:identifications>
      </dcc:item>
    </dcc:items>

    <dcc:calibrationLaboratory>
      <dcc:contact>
        <dcc:name><dcc:content>Laboratory contact</dcc:content></dcc:name>
        <dcc:eMail>lab@example.org</dcc:eMail>
        <dcc:location><dcc:city>Braunschweig</dcc:city></dcc:location>
      </dcc:contact>
    </dcc:calibrationLaboratory>

    <dcc:respPersons>
      <dcc:respPerson>
        <dcc:person>
          <dcc:name><dcc:content>Responsible Signer</dcc:content></dcc:name>
        </dcc:person>
      </dcc:respPerson>
    </dcc:respPersons>

    <dcc:customer>
      <dcc:name><dcc:content>Customer Ltd</dcc:content></dcc:name>
      <dcc:eMail>customer@example.org</dcc:eMail>
      <dcc:location><dcc:city>Hamburg</dcc:city></dcc:location>
    </dcc:customer>
  </dcc:administrativeData>

  <dcc:measurementResults>
    <dcc:measurementResult>
      <dcc:results>
        <dcc:result>
          <dcc:name><dcc:content>Temperature series</dcc:content></dcc:name>
          <dcc:data>
            <dcc:quantity>
              <dcc:name><dcc:content>Temperature points</dcc:content></dcc:name>
              <si:list>
                <si:listUnit>\degreeCelsius</si:listUnit>
                <si:real>
                  <si:value>21.4</si:value>
                  <si:expandedUnc>
                    <si:uncertainty>0.2</si:uncertainty>
                    <si:coverageFactor>2</si:coverageFactor>
                    <si:coverageProbability>0.95</si:coverageProbability>
                  </si:expandedUnc>
                </si:real>
                <si:real>
                  <si:value>22.6</si:value>
                  <si:coverageInterval>
                    <si:standardUnc>0.1</si:standardUnc>
                    <si:intervalMin>22.4</si:intervalMin>
                    <si:intervalMax>22.8</si:intervalMax>
                    <si:coverageProbability>0.95</si:coverageProbability>
                  </si:coverageInterval>
                </si:real>
              </si:list>
            </dcc:quantity>
          </dcc:data>
        </dcc:result>
      </dcc:results>
    </dcc:measurementResult>
  </dcc:measurementResults>
</dcc:digitalCalibrationCertificate>
